    "corpus:score": "tsx scripts/evaluate-corpus.ts",
    "check": "npm run test && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
