  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
